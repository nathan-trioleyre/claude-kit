{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git branch -a*)",
      "Bash(git branch -v*)",
      "Bash(git branch --show-current)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.prod*)",
      "Read(**/.env.dev*)",
      "Read(**/.env.staging*)",
      "Read(**/.env.test*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/credentials.json)",
      "Bash(cat *.env)",
      "Bash(cat *.env.*)",
      "Bash(type *.env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SCRIPT=session-check.py; . \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SCRIPT=guard.py; . \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SCRIPT=format.py; . \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh\"",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SCRIPT=verify-stop.py; . \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
