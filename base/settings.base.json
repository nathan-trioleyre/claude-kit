{
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --list*)",
      "Bash(git branch -a*)",
      "Bash(git branch -v*)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git stash list*)",
      "Bash(git worktree list*)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.prod*)",
      "Read(**/.env.dev*)",
      "Read(**/.env.staging*)",
      "Read(**/.env.test*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/credentials.json)",
      "Read(**/.env.stage*)",
      "Read(**/.env.preprod*)",
      "Read(**/.env.uat*)",
      "Read(**/.env.qa*)",
      "Read(**/.env.secret*)",
      "Read(**/.aws/credentials)",
      "Read(**/.git-credentials)",
      "Read(**/.netrc)",
      "Read(**/.docker/config.json)",
      "Read(**/*.tfvars)",
      "Bash(cat *.env)",
      "Bash(cat *.env.*)",
      "Bash(type *.env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SCRIPT=session-check.py; . \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell|Read",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SCRIPT=guard.py; . \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SCRIPT=format.py; . \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "HOOK_SCRIPT=verify-stop.py; . \"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
