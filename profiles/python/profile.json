{
  "stack": "python",
  "display_name": "Python",
  "detect": [
    "pyproject.toml",
    "requirements*.txt",
    "setup.py",
    "Pipfile"
  ],
  "commands": {
    "install": "uv sync",
    "dev": null,
    "test": "{run} pytest",
    "test_related": "{run} pytest <file>",
    "lint": "{run} ruff check .",
    "format": "{run} ruff format .",
    "hygiene": "uvx deptry . && uvx vulture . --min-confidence 80",
    "audit": "uvx pip-audit",
    "build": "uv build",
    "verify": "{run} ruff check . && {run} mypy . && {run} pytest"
  },
  "verify_steps": [
    {
      "cmd": "{run} ruff check .",
      "concern": "linter",
      "command_key": "lint"
    },
    {
      "cmd": "{run} mypy .",
      "concern": "typechecker"
    },
    {
      "cmd": "{run} pytest",
      "concern": "package-manager",
      "command_key": "test"
    }
  ],
  "permissions_allow": [
    "Bash(uv sync*)",
    "Bash({run} pytest*)",
    "Bash({run} ruff*)",
    "Bash({run} mypy*)",
    "Bash(pytest*)",
    "Bash(ruff*)",
    "Bash(mypy*)",
    "Bash(uvx deptry*)",
    "Bash(uvx vulture*)",
    "Bash(uvx pip-audit*)"
  ],
  "format_rules": [
    {
      "extensions": [
        ".py"
      ],
      "command": [
        "ruff",
        "format",
        "{file}"
      ]
    }
  ],
  "tooling": [
    {
      "concern": "formatter",
      "kit": {
        "name": "ruff format",
        "markers": [
          {
            "file": "ruff.toml"
          },
          {
            "file": ".ruff.toml"
          },
          {
            "file": "pyproject.toml",
            "contains": "[tool.ruff"
          }
        ],
        "commands": [
          "format"
        ],
        "format_rules": true,
        "practice_terms": [
          "ruff"
        ],
        "preset_files": [
          {
            "src": "presets/ruff.toml.template",
            "dest": "ruff.toml",
            "mode": "create"
          }
        ],
        "install_packages": {
          "uv": [
            "ruff"
          ],
          "poetry": [
            "ruff"
          ]
        }
      },
      "alternatives": [
        {
          "name": "black",
          "markers": [
            {
              "file": "pyproject.toml",
              "contains": "[tool.black]"
            },
            {
              "file": ".pre-commit-config.yaml",
              "contains": "psf/black"
            }
          ],
          "hooks": [
            "black"
          ],
          "commands": {
            "format": "{run} black ."
          },
          "format_rule": {
            "extensions": [
              ".py"
            ],
            "command": [
              "black",
              "{file}"
            ]
          },
          "permissions_allow": [
            "Bash({run} black*)",
            "Bash(black*)"
          ]
        },
        {
          "name": "yapf",
          "markers": [
            {
              "file": ".style.yapf"
            },
            {
              "file": "pyproject.toml",
              "contains": "[tool.yapf]"
            }
          ],
          "hooks": [
            "yapf"
          ],
          "commands": {
            "format": "{run} yapf -ir ."
          },
          "format_rule": {
            "extensions": [
              ".py"
            ],
            "command": [
              "yapf",
              "-i",
              "{file}"
            ]
          },
          "permissions_allow": [
            "Bash({run} yapf*)",
            "Bash(yapf*)"
          ]
        }
      ]
    },
    {
      "concern": "linter",
      "kit": {
        "name": "ruff check",
        "markers": [
          {
            "file": "ruff.toml"
          },
          {
            "file": ".ruff.toml"
          },
          {
            "file": "pyproject.toml",
            "contains": "[tool.ruff"
          }
        ],
        "commands": [
          "lint"
        ],
        "permissions": [
          "Bash(ruff*)"
        ],
        "practice_terms": [
          "ruff"
        ],
        "preset_files": [
          {
            "src": "presets/ruff.toml.template",
            "dest": "ruff.toml",
            "mode": "create"
          }
        ],
        "install_packages": {
          "uv": [
            "ruff"
          ],
          "poetry": [
            "ruff"
          ]
        },
        "post_edit_check": {
          "extensions": [
            ".py"
          ],
          "command": [
            "ruff",
            "check",
            "--fix",
            "{file}"
          ]
        }
      },
      "alternatives": [
        {
          "name": "flake8",
          "markers": [
            {
              "file": ".flake8"
            },
            {
              "file": "setup.cfg",
              "contains": "[flake8]"
            },
            {
              "file": "tox.ini",
              "contains": "[flake8]"
            }
          ],
          "hooks": [
            "flake8"
          ],
          "commands": {
            "lint": "{run} flake8 ."
          },
          "permissions_allow": [
            "Bash({run} flake8*)",
            "Bash(flake8*)"
          ]
        },
        {
          "name": "pylint",
          "markers": [
            {
              "file": ".pylintrc"
            },
            {
              "file": "pylintrc"
            },
            {
              "file": "pyproject.toml",
              "contains": "[tool.pylint"
            }
          ],
          "hooks": [
            "pylint"
          ],
          "permissions_allow": [
            "Bash({run} pylint*)",
            "Bash(pylint*)"
          ],
          "commands": {
            "lint": "{run} pylint --recursive=y ."
          }
        }
      ]
    },
    {
      "concern": "package-manager",
      "kit": {
        "name": "uv",
        "markers": [
          {
            "file": "uv.lock"
          },
          {
            "file": "pyproject.toml",
            "contains": "[tool.uv"
          }
        ],
        "commands": [
          "install",
          "dev",
          "test",
          "test_related",
          "lint",
          "format",
          "build",
          "verify"
        ],
        "permissions": [
          "Bash(uv sync*)",
          "Bash({run} pytest*)",
          "Bash({run} ruff*)",
          "Bash({run} mypy*)"
        ],
        "practice_terms": [
          "uv"
        ],
        "runner": "uv run"
      },
      "alternatives": [
        {
          "name": "poetry",
          "markers": [
            {
              "file": "poetry.lock"
            },
            {
              "file": "pyproject.toml",
              "contains": "[tool.poetry]"
            }
          ],
          "hooks": [
            "poetry"
          ],
          "commands": {
            "install": "poetry install",
            "test": "{run} pytest",
            "test_related": "{run} pytest <file>",
            "lint": "{run} ruff check .",
            "format": "{run} ruff format .",
            "build": "poetry build"
          },
          "permissions_allow": [
            "Bash(poetry install*)",
            "Bash({run} pytest*)",
            "Bash({run} ruff*)",
            "Bash({run} mypy*)",
            "Bash({run} black*)",
            "Bash({run} flake8*)",
            "Bash(poetry build*)"
          ],
          "runner": "poetry run"
        },
        {
          "name": "pdm",
          "markers": [
            {
              "file": "pdm.lock"
            },
            {
              "file": "pyproject.toml",
              "contains": "[tool.pdm"
            }
          ],
          "hooks": [
            "pdm"
          ],
          "commands": {
            "install": "pdm install",
            "test": "{run} pytest",
            "test_related": "{run} pytest <file>",
            "lint": "{run} ruff check .",
            "format": "{run} ruff format .",
            "build": "pdm build"
          },
          "permissions_allow": [
            "Bash(pdm install*)",
            "Bash({run} pytest*)",
            "Bash({run} ruff*)",
            "Bash({run} mypy*)",
            "Bash(pdm build*)"
          ],
          "runner": "pdm run"
        },
        {
          "name": "pipenv",
          "markers": [
            {
              "file": "Pipfile"
            },
            {
              "file": "Pipfile.lock"
            }
          ],
          "hooks": [
            "pipenv"
          ],
          "commands": {
            "install": "pipenv install --dev",
            "test": "{run} pytest",
            "test_related": "{run} pytest <file>",
            "lint": "{run} ruff check .",
            "format": "{run} ruff format ."
          },
          "permissions_allow": [
            "Bash(pipenv install*)",
            "Bash({run} pytest*)",
            "Bash({run} ruff*)",
            "Bash({run} mypy*)"
          ],
          "runner": "pipenv run"
        }
      ]
    },
    {
      "concern": "typechecker",
      "kit": {
        "name": "mypy",
        "markers": [
          {
            "file": "mypy.ini"
          },
          {
            "file": ".mypy.ini"
          },
          {
            "file": "pyproject.toml",
            "contains": "[tool.mypy"
          }
        ],
        "commands": [],
        "permissions": [
          "Bash({run} mypy*)",
          "Bash(mypy*)"
        ],
        "only_when_installed": true,
        "preset_files": [
          {
            "src": "presets/mypy.ini.template",
            "dest": "mypy.ini",
            "mode": "create"
          }
        ],
        "install_packages": {
          "uv": [
            "mypy"
          ],
          "poetry": [
            "mypy"
          ]
        }
      },
      "alternatives": [
        {
          "name": "pyright",
          "markers": [
            {
              "file": "pyrightconfig.json"
            },
            {
              "file": "pyproject.toml",
              "contains": "[tool.pyright"
            }
          ],
          "hooks": [
            "pyright"
          ],
          "permissions_allow": [
            "Bash({run} pyright*)",
            "Bash(pyright*)"
          ]
        }
      ]
    }
  ],
  "sources": [
    "https://docs.astral.sh/uv/",
    "https://docs.astral.sh/ruff/",
    "https://mypy.readthedocs.io/en/stable/config_file.html",
    "https://docs.pytest.org/",
    "https://peps.python.org/pep-0008/",
    "https://docs.astral.sh/uv/concepts/projects/layout/",
    "https://docs.astral.sh/ruff/formatter/",
    "https://docs.pytest.org/en/stable/explanation/goodpractices.html",
    "https://docs.python.org/3/tutorial/controlflow.html",
    "https://docs.python.org/3/howto/logging.html"
  ],
  "last_verified": "2026-11-28"
}
