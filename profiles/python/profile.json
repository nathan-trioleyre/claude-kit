{
  "stack": "python",
  "display_name": "Python (uv + ruff + pytest)",
  "detect": [
    "pyproject.toml",
    "requirements*.txt",
    "setup.py",
    "Pipfile"
  ],
  "commands": {
    "install": "uv sync",
    "dev": null,
    "test": "uv run pytest",
    "lint": "uv run ruff check .",
    "format": "uv run ruff format .",
    "build": "uv build",
    "verify": "uv run ruff check . && uv run pytest"
  },
  "verify_steps": [
    {
      "cmd": "uv run ruff check .",
      "concern": "linter",
      "command_key": "lint"
    },
    {
      "cmd": "uv run mypy .",
      "concern": "typechecker"
    },
    {
      "cmd": "uv run pytest",
      "concern": "package-manager",
      "command_key": "test"
    }
  ],
  "permissions_allow": [
    "Bash(uv sync*)",
    "Bash(uv run pytest*)",
    "Bash(uv run ruff*)",
    "Bash(uv run mypy*)",
    "Bash(pytest*)",
    "Bash(ruff*)",
    "Bash(mypy*)"
  ],
  "format_rules": [
    {
      "extensions": [
        ".py"
      ],
      "command": [
        "ruff",
        "format",
        "{file}"
      ]
    }
  ],
  "tooling": [
    {
      "concern": "formatter",
      "kit": {
        "name": "ruff format",
        "markers": [
          {
            "file": "ruff.toml"
          },
          {
            "file": ".ruff.toml"
          },
          {
            "file": "pyproject.toml",
            "contains": "[tool.ruff"
          }
        ],
        "commands": [
          "format"
        ],
        "format_rules": true,
        "practice_terms": [
          "ruff"
        ],
        "preset_files": [
          {
            "src": "presets/ruff.toml.template",
            "dest": "ruff.toml",
            "mode": "create"
          }
        ],
        "install_packages": {
          "uv": ["ruff"],
          "poetry": ["ruff"]
        }
      },
      "alternatives": [
        {
          "name": "black",
          "markers": [
            {
              "file": "pyproject.toml",
              "contains": "[tool.black]"
            },
            {
              "file": ".pre-commit-config.yaml",
              "contains": "psf/black"
            }
          ],
          "hooks": [
            "black"
          ],
          "commands": {
            "format": "black ."
          },
          "format_rule": {
            "extensions": [
              ".py"
            ],
            "command": [
              "black",
              "{file}"
            ]
          }
        },
        {
          "name": "yapf",
          "markers": [
            {
              "file": ".style.yapf"
            },
            {
              "file": "pyproject.toml",
              "contains": "[tool.yapf]"
            }
          ],
          "hooks": [
            "yapf"
          ]
        }
      ]
    },
    {
      "concern": "linter",
      "kit": {
        "name": "ruff check",
        "markers": [
          {
            "file": "ruff.toml"
          },
          {
            "file": ".ruff.toml"
          },
          {
            "file": "pyproject.toml",
            "contains": "[tool.ruff"
          }
        ],
        "commands": [
          "lint"
        ],
        "permissions": [
          "Bash(ruff*)"
        ],
        "practice_terms": [
          "ruff"
        ],
        "preset_files": [
          {
            "src": "presets/ruff.toml.template",
            "dest": "ruff.toml",
            "mode": "create"
          }
        ],
        "install_packages": {
          "uv": ["ruff"],
          "poetry": ["ruff"]
        },
        "post_edit_check": {
          "extensions": [
            ".py"
          ],
          "command": [
            "ruff",
            "check",
            "--fix",
            "{file}"
          ]
        }
      },
      "alternatives": [
        {
          "name": "flake8",
          "markers": [
            {
              "file": ".flake8"
            },
            {
              "file": "setup.cfg",
              "contains": "[flake8]"
            },
            {
              "file": "tox.ini",
              "contains": "[flake8]"
            }
          ],
          "hooks": [
            "flake8"
          ],
          "commands": {
            "lint": "flake8"
          },
          "permissions_allow": [
            "Bash(flake8*)"
          ]
        },
        {
          "name": "pylint",
          "markers": [
            {
              "file": ".pylintrc"
            },
            {
              "file": "pylintrc"
            },
            {
              "file": "pyproject.toml",
              "contains": "[tool.pylint"
            }
          ],
          "hooks": [
            "pylint"
          ],
          "permissions_allow": [
            "Bash(pylint*)"
          ]
        }
      ]
    },
    {
      "concern": "package-manager",
      "kit": {
        "name": "uv",
        "markers": [
          {
            "file": "uv.lock"
          },
          {
            "file": "pyproject.toml",
            "contains": "[tool.uv"
          }
        ],
        "commands": [
          "install",
          "dev",
          "test",
          "lint",
          "format",
          "build",
          "verify"
        ],
        "permissions": [
          "Bash(uv sync*)",
          "Bash(uv run pytest*)",
          "Bash(uv run ruff*)",
          "Bash(uv run mypy*)"
        ],
        "practice_terms": [
          "uv"
        ]
      },
      "alternatives": [
        {
          "name": "poetry",
          "markers": [
            {
              "file": "poetry.lock"
            },
            {
              "file": "pyproject.toml",
              "contains": "[tool.poetry]"
            }
          ],
          "hooks": [
            "poetry"
          ],
          "commands": {
            "install": "poetry install",
            "test": "poetry run pytest",
            "lint": "poetry run ruff check .",
            "format": "poetry run ruff format .",
            "build": "poetry build",
            "verify": "poetry run ruff check . && poetry run pytest"
          },
          "permissions_allow": [
            "Bash(poetry install*)",
            "Bash(poetry run pytest*)",
            "Bash(poetry run ruff*)",
            "Bash(poetry run mypy*)",
            "Bash(poetry build*)"
          ]
        },
        {
          "name": "pdm",
          "markers": [
            {
              "file": "pdm.lock"
            },
            {
              "file": "pyproject.toml",
              "contains": "[tool.pdm"
            }
          ],
          "hooks": [
            "pdm"
          ]
        },
        {
          "name": "pipenv",
          "markers": [
            {
              "file": "Pipfile"
            },
            {
              "file": "Pipfile.lock"
            }
          ],
          "hooks": [
            "pipenv"
          ]
        }
      ]
    },
    {
      "concern": "typechecker",
      "kit": {
        "name": "mypy",
        "markers": [
          {
            "file": "mypy.ini"
          },
          {
            "file": ".mypy.ini"
          },
          {
            "file": "pyproject.toml",
            "contains": "[tool.mypy"
          }
        ],
        "commands": [],
        "permissions": [
          "Bash(uv run mypy*)",
          "Bash(mypy*)"
        ],
        "only_when_installed": true,
        "preset_files": [
          {
            "src": "presets/mypy.ini.template",
            "dest": "mypy.ini",
            "mode": "create"
          }
        ],
        "install_packages": {
          "uv": ["mypy"],
          "poetry": ["mypy"]
        }
      },
      "alternatives": [
        {
          "name": "pyright",
          "markers": [
            {
              "file": "pyrightconfig.json"
            },
            {
              "file": "pyproject.toml",
              "contains": "[tool.pyright"
            }
          ],
          "hooks": [
            "pyright"
          ],
          "permissions_allow": [
            "Bash(uv run pyright*)",
            "Bash(pyright*)"
          ]
        }
      ]
    }
  ],
  "sources": [
    "https://docs.astral.sh/uv/",
    "https://docs.astral.sh/ruff/",
    "https://mypy.readthedocs.io/en/stable/config_file.html",
    "https://docs.pytest.org/",
    "https://peps.python.org/pep-0008/"
  ],
  "last_verified": "2026-11-27"
}
