{
  "stack": "stack-name",
  "display_name": "Readable name (e.g., Python 3.12 + uv)",
  "detect": ["hint-file.toml", "*.hint-ext", {"file": "manifest.json", "contains": "framework-name"}, {"all": ["config.*", {"file": "manifest.json", "contains": "framework-name"}]}],
  "paths": [],
  "commands": {
    "install": "command or null",
    "dev": "command or null",
    "test": "command or null",
    "test_related": "targeted single-file test command or null",
    "lint": "command or null",
    "format": "command or null",
    "hygiene": "dead code / unused deps check or null",
    "audit": "security / vulnerability audit or null",
    "build": "command or null",
    "verify": "the single command to run before saying 'done'"
  },
  "verify_steps": [
    { "cmd": "{run} lint-command", "concern": "linter" },
    { "cmd": "test-command", "concern": null }
  ],
  "permissions_allow": ["Bash(test-command *)", "Bash({run} lint-tool*)"],
  "format_rules": [
    { "extensions": [".ext"], "command": ["formatter", "{file}"] }
  ],
  "tooling": [
    {
      "concern": "formatter",
      "kit": {
        "name": "kit-formatter",
        "markers": [{ "file": "kit-formatter.toml" }],
        "commands": ["format"],
        "format_rules": true,
        "preset_files": [{ "src": "presets/kit-formatter.toml.template", "dest": "kit-formatter.toml", "mode": "create" }],
        "install_packages": ["kit-formatter"]
      },
      "alternatives": [
        { "name": "other-formatter", "markers": [{ "file": "config.toml", "contains": "[other-formatter]" }], "hooks": ["other-formatter"] }
      ]
    },
    {
      "concern": "package-manager",
      "kit": {
        "name": "kit-pm",
        "markers": [{ "file": "kit-pm.lock" }],
        "commands": ["install", "test", "lint"],
        "runner": "kit-pm run"
      },
      "alternatives": [
        { "name": "other-pm", "markers": [{ "file": "other-pm.lock" }], "runner": "other-pm exec", "commands": { "install": "other-pm install", "test": "{run} test-tool", "lint": "{run} lint-command" } }
      ]
    }
  ],
  "sources": ["https://official-documentation"],
  "last_verified": "YYYY-MM-DD"
}
