{
  "stack": "docker",
  "display_name": "Docker / Compose",
  "detect": [
    "Dockerfile",
    "Dockerfile.*",
    "docker-compose*.yml",
    "docker-compose*.yaml",
    "compose.yml",
    "compose.yaml"
  ],
  "paths": [],
  "commands": {
    "install": null,
    "dev": "docker compose up --build",
    "test": null,
    "lint": "docker compose config --quiet",
    "format": null,
    "build": "docker build .",
    "verify": null
  },
  "permissions_allow": [
    "Bash(hadolint*)",
    "Bash(docker build*)",
    "Bash(docker compose config*)"
  ],
  "format_rules": [],
  "tooling": [
    {
      "concern": "linter",
      "kit": {
        "name": "hadolint",
        "markers": [
          {
            "file": ".hadolint.yaml"
          },
          {
            "file": ".hadolint.yml"
          }
        ],
        "commands": [],
        "permissions": [
          "Bash(hadolint *)"
        ],
        "only_when_installed": true,
        "preset_files": [
          {
            "src": "presets/.hadolint.yaml.template",
            "dest": ".hadolint.yaml",
            "mode": "create"
          }
        ],
        "post_edit_check": {
          "extensions": [
            ".dockerfile"
          ],
          "filenames": [
            "Dockerfile",
            "Dockerfile.*"
          ],
          "command": [
            "hadolint",
            "{file}"
          ]
        }
      }
    }
  ],
  "sources": [
    "https://docs.docker.com/build/building/best-practices/",
    "https://docs.docker.com/compose/compose-file/",
    "https://github.com/hadolint/hadolint",
    "https://docs.docker.com/build/building/secrets/",
    "https://docs.docker.com/build/cache/optimize/",
    "https://docs.docker.com/compose/how-tos/use-secrets/",
    "https://docs.docker.com/reference/cli/docker/compose/config/"
  ],
  "last_verified": "2026-11-28"
}
