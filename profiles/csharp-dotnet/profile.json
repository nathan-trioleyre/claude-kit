{
  "stack": "csharp-dotnet",
  "display_name": "C# / .NET (dotnet CLI)",
  "detect": [
    "*.sln",
    "*.slnx",
    "*.csproj",
    "global.json"
  ],
  "commands": {
    "install": "dotnet restore",
    "dev": null,
    "test": "dotnet test",
    "lint": "dotnet format --verify-no-changes",
    "format": "dotnet format",
    "build": "dotnet build --no-restore",
    "verify": "dotnet build && dotnet test"
  },
  "permissions_allow": [
    "Bash(dotnet restore*)",
    "Bash(dotnet build*)",
    "Bash(dotnet test*)",
    "Bash(dotnet format*)"
  ],
  "format_rules": [],
  "tooling": [
    {
      "concern": "formatter",
      "kit": {
        "name": "dotnet format",
        "markers": [],
        "commands": [
          "format",
          "lint"
        ],
        "permissions": [
          "Bash(dotnet format*)"
        ]
      },
      "alternatives": [
        {
          "name": "csharpier",
          "markers": [
            {
              "file": ".csharpierrc*"
            },
            {
              "file": ".config/dotnet-tools.json",
              "contains": "csharpier"
            }
          ],
          "hooks": [
            "csharpier"
          ]
        }
      ]
    },
    {
      "concern": "analyzers",
      "kit": {
        "name": "roslyn-analyzers",
        "markers": [
          {
            "file": "Directory.Build.props",
            "contains": "AnalysisLevel"
          },
          {
            "file": ".globalconfig"
          }
        ],
        "commands": [],
        "only_when_installed": true,
        "preset_files": [
          {
            "src": "presets/Directory.Build.props",
            "dest": "Directory.Build.props",
            "mode": "create"
          },
          {
            "src": "presets/.globalconfig",
            "dest": ".globalconfig",
            "mode": "create"
          }
        ]
      }
    }
  ],
  "sources": [
    "https://learn.microsoft.com/en-us/dotnet/core/tools/",
    "https://learn.microsoft.com/en-us/dotnet/csharp/fundamentals/coding-style/coding-conventions",
    "https://learn.microsoft.com/en-us/dotnet/fundamentals/code-analysis/configuration-files",
    "https://learn.microsoft.com/en-us/aspnet/core/",
    "https://learn.microsoft.com/en-us/aspnet/core/security/app-secrets",
    "https://learn.microsoft.com/en-us/dotnet/core/extensions/logging"
  ],
  "last_verified": "2026-11-27"
}
