{
  "stack": "angular",
  "display_name": "Angular (Angular CLI)",
  "detect": [
    "angular.json"
  ],
  "supersedes": [
    "typescript"
  ],
  "paths": [],
  "commands": {
    "install": "npm ci",
    "dev": "npm start",
    "test": "npm test -- --no-watch",
    "test_related": "npm test -- --no-watch --include <spec>",
    "lint": "npm run lint",
    "format": "npm run format",
    "hygiene": "{run} knip",
    "audit": "npm audit --audit-level=high",
    "build": "npm run build",
    "verify": "npm run lint && npm test -- --no-watch && npm run build"
  },
  "verify_steps": [
    {
      "cmd": "npm run lint",
      "concern": "linter",
      "command_key": "lint"
    },
    {
      "cmd": "npm test -- --no-watch",
      "concern": "package-manager",
      "command_key": "test"
    },
    {
      "cmd": "npm run build",
      "concern": "package-manager",
      "command_key": "build"
    }
  ],
  "permissions_allow": [
    "Bash(npm ci)",
    "Bash(npm test*)",
    "Bash(npm run build*)",
    "Bash(npm run lint*)",
    "Bash(npm run test*)",
    "Bash(npm run typecheck*)",
    "Bash(npm run format*)",
    "Bash(npm audit*)",
    "Bash(ng test*)",
    "Bash(ng build*)",
    "Bash(ng lint*)"
  ],
  "format_rules": [
    {
      "extensions": [
        ".ts",
        ".html",
        ".scss",
        ".css",
        ".json"
      ],
      "command": [
        "prettier",
        "--write",
        "{file}"
      ]
    }
  ],
  "tooling": [
    {
      "concern": "formatter",
      "kit": {
        "name": "prettier",
        "markers": [
          {
            "file": ".prettierrc*"
          },
          {
            "file": "prettier.config.*"
          },
          {
            "file": "package.json",
            "contains": "\"prettier\""
          }
        ],
        "commands": [
          "format"
        ],
        "format_rules": true,
        "preset_files": [
          {
            "src": "presets/.prettierrc.template",
            "dest": ".prettierrc",
            "mode": "create"
          }
        ],
        "install_packages": [
          "prettier"
        ],
        "scripts": {
          "format": "prettier --write ."
        }
      },
      "alternatives": [
        {
          "name": "biome",
          "markers": [
            {
              "file": "biome.json"
            },
            {
              "file": "biome.jsonc"
            }
          ],
          "hooks": [
            "biome"
          ],
          "format_rule": {
            "extensions": [
              ".ts",
              ".html",
              ".css",
              ".json"
            ],
            "command": [
              "biome",
              "format",
              "--write",
              "{file}"
            ]
          },
          "commands": {
            "format": "{run} biome format --write ."
          },
          "permissions_allow": [
            "Bash({run} biome*)"
          ]
        },
        {
          "name": "dprint",
          "markers": [
            {
              "file": "dprint.json"
            },
            {
              "file": ".dprint.json"
            }
          ],
          "hooks": [
            "dprint"
          ]
        }
      ]
    },
    {
      "concern": "linter",
      "kit": {
        "name": "angular-eslint",
        "markers": [
          {
            "file": "eslint.config.*"
          },
          {
            "file": ".eslintrc*"
          },
          {
            "file": "package.json",
            "contains": "\"angular-eslint\""
          }
        ],
        "commands": [
          "lint"
        ],
        "permissions": [
          "Bash(npm run lint*)",
          "Bash(ng lint*)"
        ],
        "preset_files": [
          {
            "src": "presets/eslint.config.mjs.template",
            "dest": "eslint.config.mjs",
            "mode": "create"
          }
        ],
        "install_packages": [
          "eslint",
          "@eslint/js",
          "typescript-eslint",
          "angular-eslint"
        ],
        "scripts": {
          "lint": "eslint ."
        },
        "post_edit_check": {
          "extensions": [
            ".ts",
            ".html"
          ],
          "command": [
            "eslint",
            "--fix",
            "{file}"
          ]
        }
      },
      "alternatives": [
        {
          "name": "biome",
          "markers": [
            {
              "file": "biome.json"
            },
            {
              "file": "biome.jsonc"
            }
          ],
          "hooks": [
            "biome"
          ],
          "post_edit_check": {
            "extensions": [
              ".ts",
              ".html"
            ],
            "command": [
              "biome",
              "check",
              "--write",
              "{file}"
            ]
          },
          "commands": {
            "lint": "{run} biome check ."
          },
          "permissions_allow": [
            "Bash({run} biome*)"
          ]
        }
      ]
    },
    {
      "concern": "package-manager",
      "kit": {
        "name": "npm",
        "markers": [
          {
            "file": "package-lock.json"
          }
        ],
        "commands": [
          "install",
          "dev",
          "test",
          "test_related",
          "lint",
          "format",
          "audit",
          "build",
          "verify"
        ],
        "permissions": [
          "Bash(npm ci)",
          "Bash(npm test*)",
          "Bash(npm run build*)",
          "Bash(npm run lint*)",
          "Bash(npm run test*)",
          "Bash(npm run typecheck*)",
          "Bash(npm run format*)",
          "Bash(npm audit*)"
        ],
        "practice_terms": [
          "npm ci",
          "package-lock.json"
        ],
        "runner": "npx"
      },
      "alternatives": [
        {
          "name": "pnpm",
          "markers": [
            {
              "file": "pnpm-lock.yaml"
            }
          ],
          "hooks": [
            "pnpm"
          ],
          "commands": {
            "install": "pnpm install --frozen-lockfile",
            "dev": "pnpm start",
            "test": "pnpm test --no-watch",
            "test_related": "pnpm test --no-watch --include <spec>",
            "lint": "pnpm run lint",
            "format": "pnpm run format",
            "build": "pnpm run build",
            "audit": "pnpm audit --audit-level=high"
          },
          "permissions_allow": [
            "Bash(pnpm install*)",
            "Bash(pnpm test*)",
            "Bash(pnpm run build*)",
            "Bash(pnpm run lint*)",
            "Bash(pnpm run test*)",
            "Bash(pnpm run typecheck*)",
            "Bash(pnpm run format*)",
            "Bash(pnpm audit*)"
          ],
          "runner": "pnpm exec"
        },
        {
          "name": "yarn",
          "markers": [
            {
              "file": "yarn.lock"
            }
          ],
          "hooks": [
            "yarn"
          ],
          "commands": {
            "install": "yarn install --frozen-lockfile",
            "dev": "yarn start",
            "test": "yarn test --no-watch",
            "test_related": "yarn test --no-watch --include <spec>",
            "lint": "yarn lint",
            "format": "yarn format",
            "build": "yarn build"
          },
          "permissions_allow": [
            "Bash(yarn install*)",
            "Bash(yarn test*)",
            "Bash(yarn build*)",
            "Bash(yarn lint*)",
            "Bash(yarn format*)",
            "Bash(yarn typecheck*)"
          ],
          "runner": "yarn"
        },
        {
          "name": "bun",
          "markers": [
            {
              "file": "bun.lock"
            },
            {
              "file": "bun.lockb"
            }
          ],
          "hooks": [
            "bun"
          ],
          "commands": {
            "install": "bun install --frozen-lockfile",
            "dev": "bun run start",
            "test": "bun run test --no-watch",
            "test_related": "bun run test --no-watch --include <spec>",
            "lint": "bun run lint",
            "format": "bun run format",
            "build": "bun run build",
            "audit": "bun audit"
          },
          "runner": "bunx"
        }
      ]
    }
  ],
  "sources": [
    "https://angular.dev/style-guide",
    "https://angular.dev/tools/cli",
    "https://angular.dev/best-practices",
    "https://angular.dev/guide/zoneless",
    "https://angular.dev/guide/testing/migrating-to-vitest",
    "https://github.com/angular-eslint/angular-eslint/blob/main/docs/CONFIGURING_ESLINT.md",
    "https://angular.dev/guide/testing",
    "https://angular.dev/guide/testing/karma",
    "https://angular.dev/reference/versions",
    "https://github.com/angular/angular/blob/main/CHANGELOG.md"
  ],
  "last_verified": "2026-11-28"
}
