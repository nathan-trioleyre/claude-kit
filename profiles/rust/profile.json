{
  "stack": "rust",
  "display_name": "Rust (Cargo + Clippy + rustfmt)",
  "detect": [
    "Cargo.toml"
  ],
  "paths": [],
  "commands": {
    "install": "cargo fetch",
    "dev": "cargo run",
    "test": "cargo test",
    "test_related": "cargo test <test_name>",
    "lint": "cargo clippy --all-targets -- -D warnings",
    "format": "cargo fmt",
    "hygiene": "cargo machete",
    "audit": "cargo audit",
    "build": "cargo build",
    "verify": "cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test"
  },
  "permissions_allow": [
    "Bash(cargo check*)",
    "Bash(cargo test*)",
    "Bash(cargo clippy*)",
    "Bash(cargo fmt*)",
    "Bash(cargo build*)",
    "Bash(cargo audit*)",
    "Bash(cargo machete*)"
  ],
  "format_rules": [
    {
      "extensions": [
        ".rs"
      ],
      "command": [
        "rustfmt",
        "{file}"
      ]
    }
  ],
  "tooling": [
    {
      "concern": "lint-config",
      "kit": {
        "name": "clippy + rustfmt config",
        "markers": [
          {
            "file": "clippy.toml"
          },
          {
            "file": ".clippy.toml"
          },
          {
            "file": "rustfmt.toml"
          },
          {
            "file": ".rustfmt.toml"
          }
        ],
        "commands": [],
        "only_when_installed": true,
        "preset_files": [
          {
            "src": "presets/clippy.toml.template",
            "dest": "clippy.toml",
            "mode": "create"
          },
          {
            "src": "presets/rustfmt.toml.template",
            "dest": "rustfmt.toml",
            "mode": "create"
          }
        ]
      }
    }
  ],
  "sources": [
    "https://doc.rust-lang.org/cargo/",
    "https://doc.rust-lang.org/clippy/",
    "https://rust-lang.github.io/rustfmt/"
  ],
  "last_verified": "2026-11-27"
}
