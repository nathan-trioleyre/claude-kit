{
  "stack": "nextjs",
  "display_name": "Next.js (App Router + TypeScript)",
  "detect": [
    "next.config.*"
  ],
  "supersedes": [
    "typescript"
  ],
  "paths": [],
  "commands": {
    "install": "npm ci",
    "dev": "npm run dev",
    "test": "npm test",
    "test_related": "npm test -- <file>",
    "lint": "npm run lint",
    "format": "npm run format",
    "hygiene": "npx knip",
    "audit": "npm audit --audit-level=high",
    "build": "npm run build",
    "verify": "npm run lint && tsc --noEmit && npm run build"
  },
  "verify_steps": [
    {
      "cmd": "npm run lint",
      "concern": "linter",
      "command_key": "lint"
    },
    {
      "cmd": "tsc --noEmit",
      "concern": "typechecker"
    },
    {
      "cmd": "npm run build",
      "concern": "package-manager",
      "command_key": "build"
    }
  ],
  "permissions_allow": [
    "Bash(npm ci)",
    "Bash(npm test*)",
    "Bash(npm run build*)",
    "Bash(npm run lint*)",
    "Bash(tsc --noEmit*)"
  ],
  "format_rules": [
    {
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".css",
        ".json"
      ],
      "command": [
        "prettier",
        "--write",
        "{file}"
      ]
    }
  ],
  "tooling": [
    {
      "concern": "formatter",
      "kit": {
        "name": "prettier",
        "markers": [
          {
            "file": ".prettierrc*"
          },
          {
            "file": "prettier.config.*"
          },
          {
            "file": "package.json",
            "contains": "\"prettier\""
          }
        ],
        "commands": [
          "format"
        ],
        "format_rules": true,
        "preset_files": [
          {
            "src": "presets/.prettierrc.template",
            "dest": ".prettierrc",
            "mode": "create"
          }
        ],
        "install_packages": [
          "prettier"
        ],
        "scripts": {
          "format": "prettier --write ."
        }
      },
      "alternatives": [
        {
          "name": "biome",
          "markers": [
            {
              "file": "biome.json"
            },
            {
              "file": "biome.jsonc"
            }
          ],
          "hooks": [
            "biome"
          ],
          "format_rule": {
            "extensions": [
              ".ts",
              ".tsx",
              ".js",
              ".jsx",
              ".css",
              ".json"
            ],
            "command": [
              "biome",
              "format",
              "--write",
              "{file}"
            ]
          }
        }
      ]
    },
    {
      "concern": "linter",
      "kit": {
        "name": "eslint",
        "markers": [
          {
            "file": "eslint.config.*"
          },
          {
            "file": ".eslintrc*"
          },
          {
            "file": "package.json",
            "contains": "\"eslint\""
          }
        ],
        "commands": [
          "lint"
        ],
        "permissions": [
          "Bash(npm run lint*)"
        ],
        "preset_files": [
          {
            "src": "presets/eslint.config.mjs.template",
            "dest": "eslint.config.mjs",
            "mode": "create"
          }
        ],
        "install_packages": [
          "eslint",
          "eslint-config-next"
        ],
        "scripts": {
          "lint": "eslint ."
        },
        "post_edit_check": {
          "extensions": [
            ".ts",
            ".tsx",
            ".js",
            ".jsx"
          ],
          "command": [
            "eslint",
            "--fix",
            "{file}"
          ]
        }
      },
      "alternatives": [
        {
          "name": "biome",
          "markers": [
            {
              "file": "biome.json"
            },
            {
              "file": "biome.jsonc"
            }
          ],
          "hooks": [
            "biome"
          ],
          "post_edit_check": {
            "extensions": [
              ".ts",
              ".tsx",
              ".js",
              ".jsx"
            ],
            "command": [
              "biome",
              "check",
              "--write",
              "{file}"
            ]
          }
        }
      ]
    },
    {
      "concern": "typechecker",
      "kit": {
        "name": "tsc",
        "markers": [
          {
            "file": "tsconfig.json"
          }
        ],
        "commands": [],
        "permissions": [
          "Bash(tsc --noEmit*)"
        ],
        "preset_files": [
          {
            "src": "presets/tsconfig.json.template",
            "dest": "tsconfig.json",
            "mode": "create"
          }
        ]
      }
    },
    {
      "concern": "package-manager",
      "kit": {
        "name": "npm",
        "markers": [
          {
            "file": "package-lock.json"
          }
        ],
        "commands": [
          "install",
          "dev",
          "test",
          "lint",
          "build",
          "verify"
        ],
        "permissions": [
          "Bash(npm ci)",
          "Bash(npm test*)",
          "Bash(npm run build*)",
          "Bash(npm run lint*)"
        ],
        "practice_terms": [
          "npm ci",
          "package-lock.json"
        ]
      },
      "alternatives": [
        {
          "name": "pnpm",
          "markers": [
            {
              "file": "pnpm-lock.yaml"
            }
          ],
          "hooks": [
            "pnpm"
          ],
          "commands": {
            "install": "pnpm install --frozen-lockfile",
            "dev": "pnpm dev",
            "test": "pnpm test",
            "lint": "pnpm lint",
            "build": "pnpm build",
            "verify": "pnpm lint && tsc --noEmit && pnpm build"
          },
          "permissions_allow": [
            "Bash(pnpm install*)",
            "Bash(pnpm test*)",
            "Bash(pnpm run build*)",
            "Bash(pnpm run lint*)"
          ]
        },
        {
          "name": "yarn",
          "markers": [
            {
              "file": "yarn.lock"
            }
          ],
          "hooks": [
            "yarn"
          ],
          "commands": {
            "install": "yarn install --frozen-lockfile",
            "dev": "yarn dev",
            "test": "yarn test",
            "lint": "yarn lint",
            "build": "yarn build",
            "verify": "yarn lint && tsc --noEmit && yarn build"
          },
          "permissions_allow": [
            "Bash(yarn install*)",
            "Bash(yarn test*)",
            "Bash(yarn build*)",
            "Bash(yarn lint*)"
          ]
        },
        {
          "name": "bun",
          "markers": [
            {
              "file": "bun.lock"
            },
            {
              "file": "bun.lockb"
            }
          ],
          "hooks": [
            "bun"
          ],
          "commands": {
            "install": "bun install --frozen-lockfile",
            "dev": "bun run dev",
            "test": "bun test",
            "lint": "bun run lint",
            "build": "bun run build",
            "verify": "bun run lint && tsc --noEmit && bun run build"
          }
        }
      ]
    }
  ],
  "sources": [
    "https://nextjs.org/docs/app/getting-started",
    "https://nextjs.org/docs/app/building-your-application/rendering/composition-patterns",
    "https://nextjs.org/docs/app/api-reference/config/eslint"
  ],
  "last_verified": "2026-11-27"
}
