{
  "stack": "typescript",
  "display_name": "TypeScript / Node.js",
  "detect": [
    "tsconfig.json"
  ],
  "paths": [],
  "commands": {
    "install": "npm ci",
    "dev": "npm run dev",
    "test": "npm test",
    "test_related": "npm test -- <file>",
    "lint": "npm run lint",
    "format": "npm run format",
    "hygiene": "{run} knip",
    "audit": "npm audit --audit-level=high",
    "build": "npm run build",
    "verify": "npm run lint && {run} tsc --noEmit && npm test && npm run build"
  },
  "verify_steps": [
    {
      "cmd": "npm run lint",
      "concern": "linter",
      "command_key": "lint"
    },
    {
      "cmd": "{run} tsc --noEmit",
      "concern": "typechecker"
    },
    {
      "cmd": "npm test",
      "concern": "package-manager",
      "command_key": "test"
    },
    {
      "cmd": "npm run build",
      "concern": "package-manager",
      "command_key": "build"
    }
  ],
  "permissions_allow": [
    "Bash(npm ci)",
    "Bash(npm test*)",
    "Bash(npm run build*)",
    "Bash(npm run lint*)",
    "Bash(npm run test*)",
    "Bash(npm run typecheck*)",
    "Bash(npm run format*)",
    "Bash(npm audit*)",
    "Bash({run} tsc*)",
    "Bash({run} eslint*)",
    "Bash({run} prettier*)"
  ],
  "format_rules": [
    {
      "extensions": [
        ".ts",
        ".tsx",
        ".js",
        ".jsx",
        ".json"
      ],
      "command": [
        "prettier",
        "--write",
        "{file}"
      ]
    }
  ],
  "tooling": [
    {
      "concern": "formatter",
      "kit": {
        "name": "prettier",
        "markers": [
          {
            "file": ".prettierrc*"
          },
          {
            "file": "prettier.config.*"
          },
          {
            "file": "package.json",
            "contains": "\"prettier\""
          }
        ],
        "commands": [
          "format"
        ],
        "format_rules": true,
        "preset_files": [
          {
            "src": "presets/.prettierrc.template",
            "dest": ".prettierrc",
            "mode": "create"
          }
        ],
        "install_packages": [
          "prettier"
        ],
        "scripts": {
          "format": "prettier --write ."
        },
        "permissions": [
          "Bash({run} prettier*)"
        ]
      },
      "alternatives": [
        {
          "name": "biome",
          "markers": [
            {
              "file": "biome.json"
            },
            {
              "file": "biome.jsonc"
            }
          ],
          "hooks": [
            "biome"
          ],
          "format_rule": {
            "extensions": [
              ".ts",
              ".tsx",
              ".js",
              ".jsx",
              ".json"
            ],
            "command": [
              "biome",
              "format",
              "--write",
              "{file}"
            ]
          },
          "commands": {
            "format": "{run} biome format --write ."
          },
          "permissions_allow": [
            "Bash({run} biome*)"
          ]
        }
      ]
    },
    {
      "concern": "linter",
      "kit": {
        "name": "eslint",
        "markers": [
          {
            "file": "eslint.config.*"
          },
          {
            "file": ".eslintrc*"
          },
          {
            "file": "package.json",
            "contains": "\"eslint\""
          }
        ],
        "commands": [
          "lint"
        ],
        "permissions": [
          "Bash(npm run lint*)",
          "Bash({run} eslint*)"
        ],
        "preset_files": [
          {
            "src": "presets/eslint.config.mjs.template",
            "dest": "eslint.config.mjs",
            "mode": "create"
          }
        ],
        "install_packages": [
          "eslint",
          "@eslint/js",
          "typescript-eslint"
        ],
        "scripts": {
          "lint": "eslint ."
        },
        "post_edit_check": {
          "extensions": [
            ".ts",
            ".tsx",
            ".js",
            ".jsx"
          ],
          "command": [
            "eslint",
            "--fix",
            "{file}"
          ]
        }
      },
      "alternatives": [
        {
          "name": "biome",
          "markers": [
            {
              "file": "biome.json"
            },
            {
              "file": "biome.jsonc"
            }
          ],
          "hooks": [
            "biome"
          ],
          "post_edit_check": {
            "extensions": [
              ".ts",
              ".tsx",
              ".js",
              ".jsx"
            ],
            "command": [
              "biome",
              "check",
              "--write",
              "{file}"
            ]
          },
          "commands": {
            "lint": "{run} biome check ."
          },
          "permissions_allow": [
            "Bash({run} biome*)"
          ]
        },
        {
          "name": "oxlint",
          "markers": [
            {
              "file": ".oxlintrc.json"
            },
            {
              "file": "oxlintrc.json"
            }
          ],
          "hooks": [
            "oxlint"
          ],
          "post_edit_check": {
            "extensions": [
              ".ts",
              ".tsx",
              ".js",
              ".jsx"
            ],
            "command": [
              "oxlint",
              "{file}"
            ]
          },
          "commands": {
            "lint": "{run} oxlint"
          },
          "permissions_allow": [
            "Bash({run} oxlint*)"
          ]
        }
      ]
    },
    {
      "concern": "typechecker",
      "kit": {
        "name": "tsc",
        "markers": [
          {
            "file": "tsconfig.json"
          }
        ],
        "commands": [],
        "permissions": [
          "Bash({run} tsc*)"
        ],
        "preset_files": [
          {
            "src": "presets/tsconfig.json.template",
            "dest": "tsconfig.json",
            "mode": "create"
          }
        ]
      }
    },
    {
      "concern": "package-manager",
      "kit": {
        "name": "npm",
        "markers": [
          {
            "file": "package-lock.json"
          }
        ],
        "commands": [
          "install",
          "dev",
          "test",
          "test_related",
          "lint",
          "format",
          "audit",
          "build",
          "verify"
        ],
        "permissions": [
          "Bash(npm ci)",
          "Bash(npm test*)",
          "Bash(npm run build*)",
          "Bash(npm run lint*)",
          "Bash(npm run test*)",
          "Bash(npm run typecheck*)",
          "Bash(npm run format*)",
          "Bash(npm audit*)"
        ],
        "practice_terms": [
          "npm ci",
          "package-lock.json"
        ],
        "runner": "npx"
      },
      "alternatives": [
        {
          "name": "pnpm",
          "markers": [
            {
              "file": "pnpm-lock.yaml"
            }
          ],
          "hooks": [
            "pnpm"
          ],
          "commands": {
            "install": "pnpm install --frozen-lockfile",
            "dev": "pnpm run dev",
            "test": "pnpm test",
            "test_related": "pnpm test <file>",
            "lint": "pnpm run lint",
            "format": "pnpm run format",
            "build": "pnpm run build",
            "audit": "pnpm audit --audit-level=high"
          },
          "permissions_allow": [
            "Bash(pnpm install*)",
            "Bash(pnpm test*)",
            "Bash(pnpm run build*)",
            "Bash(pnpm run lint*)",
            "Bash(pnpm run test*)",
            "Bash(pnpm run typecheck*)",
            "Bash(pnpm run format*)",
            "Bash(pnpm audit*)"
          ],
          "runner": "pnpm exec"
        },
        {
          "name": "yarn",
          "markers": [
            {
              "file": "yarn.lock"
            }
          ],
          "hooks": [
            "yarn"
          ],
          "commands": {
            "install": "yarn install --frozen-lockfile",
            "dev": "yarn dev",
            "test": "yarn test",
            "test_related": "yarn test <file>",
            "lint": "yarn lint",
            "format": "yarn format",
            "build": "yarn build"
          },
          "permissions_allow": [
            "Bash(yarn install*)",
            "Bash(yarn test*)",
            "Bash(yarn build*)",
            "Bash(yarn lint*)",
            "Bash(yarn format*)",
            "Bash(yarn typecheck*)"
          ],
          "runner": "yarn"
        },
        {
          "name": "bun",
          "markers": [
            {
              "file": "bun.lock"
            },
            {
              "file": "bun.lockb"
            }
          ],
          "hooks": [
            "bun"
          ],
          "commands": {
            "install": "bun install --frozen-lockfile",
            "dev": "bun run dev",
            "test": "bun run test",
            "test_related": "bun run test <file>",
            "lint": "bun run lint",
            "format": "bun run format",
            "build": "bun run build",
            "audit": "bun audit"
          },
          "runner": "bunx"
        }
      ]
    }
  ],
  "sources": [
    "https://www.typescriptlang.org/tsconfig/",
    "https://nodejs.org/en/learn/getting-started/introduction-to-nodejs",
    "https://typescript-eslint.io/getting-started/",
    "https://eslint.org/docs/latest/use/configure/configuration-files",
    "https://typescript-eslint.io/rules/no-explicit-any/",
    "https://typescript-eslint.io/rules/explicit-module-boundary-types/",
    "https://docs.npmjs.com/cli/v11/commands/npm-ci"
  ],
  "last_verified": "2026-11-28"
}
